iodevice/labjacku6 LabJackU6 (
    pulse_duration = juice
    pulse_on = juice
    lever1 = FIO1
    lever1_solenoid = MIO0
    laser_trigger = laserTrigger
    optic_device = optic_device
    strobed_digital_word = strobedDigitalWord
    counter = counter
    do2led = do2led
    led_seq = led_seq
    LED_duration = LED_durationMS
    led1_status = led1_status
    led2_status = led2_status
    do_wheelspeed = DoWheelSpeed
    ws_durationUS = speedIntervalUS
    wheel_speed = wheelSpeed
    doCB = doCerebellarStim
    quadrature = quadrature
    )

group 'Experiment variables' {
var subjectNum = 999
var folderName = 'photodiode' (persistant = 1)
var capture_display_image = false
    }
    
group 'Stimulus' {    
var photoStimulusAzimuth = 46.8 (persistant = 1)
var photoStimulusElevation = -24.5 (persistant = 1)
    }

group 'Hardware variables' {
    var FIO1 = 0
    var MIO0 = (bool)(0)
    var laserTrigger = (bool)(0)
    var strobedDigitalWord = 0
    var juice = 0
    var sendLaserParams = 0
    var sendSerialParams = 0
    var counter = 0
    var do2led = (bool)(0)
    var LED_durationMS = (float)(0)
    var led1_status = (bool)(0)
    var led2_status = (bool)(0)
    var led_seq = [1,1,1,2]
    var quadrature = 0 
    var optic_device = 'led'
    var doCerebellarStim = 0
    var DoWheelSpeed = 0
    var speedIntervalUS = 0
    var wheelSpeed = 0
    var sync = 0
    var image_number = 0
    var trial_number = 0
    }

python_file ('noise_stimulus.py')

stimulus_display (
    capture_format = PNG
    capture_enabled = capture_display_image
    )

rectangle photoRectOn (
    color = 1,1,1
    x_size = 8
    y_size = 8
    x_position = photoStimulusAzimuth
    y_position = photoStimulusElevation
    )

rectangle photoRectOff (
    color = 0,0,0
    x_size = 8
    y_size = 8
    x_position = photoStimulusAzimuth
    y_position = photoStimulusElevation
    )  



protocol 'Generate photomovie' {
    task {
        state 'Start' {
            queue_stimulus (photoRectOn)
            goto ('Capture image on')
        }

        state 'Capture image on' {
            image_number = 1
            trial_number = 1
            capture_display_image = true
            update_display ()

            goto (
                target = 'Capture image off'
                when = not capture_display_image
                )
        }

        state 'Capture image off' {
            image_number = 2
            queue_stimulus (photoRectOff)
            capture_display_image = true
            update_display ()

            goto (
                target = 'Stop'
                when = not capture_display_image
                )
        }
        
        state 'Stop' {
            clear_display ()

            yield ()
        }
    }
}
