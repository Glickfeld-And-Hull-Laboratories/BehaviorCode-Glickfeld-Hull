//
// Stimuli
//

blank_screen background ()

layer targetOne {
    drifting_grating targetOne_grating (
        direction = setTargetOneGratingDirectionDeg
        starting_phase = tTargetOneGratingPhaseDeg + 360 *  tTargetOneGratingSpatialFreqCPD * (tTargetOneGratingDiameterDeg/2)
        spatial_frequency = tTargetOneGratingSpatialFreqCPD
        speed = tTargetOneGratingTemporalFreqCPS/tTargetOneGratingSpatialFreqCPD
        grating_type = gratingType
        x_size = tTargetOneGratingDiameterDeg
        x_position = tTargetOneGratingAzimuthDeg
        y_position = tTargetOneGratingElevationDeg
        alpha_multiplier = tTargetOneGratingContrast
        dest_blend_factor = zero
        autoplay = true
        )

    drifting_grating targetOne_mask (
        direction = 0
        starting_phase = 0
        spatial_frequency = tTargetOneGratingSpatialFreqCPD
        speed = 0
        grating_type = gratingType
        x_size = tTargetOneGratingDiameterDeg
        x_position = tTargetOneGratingAzimuthDeg
        y_position = tTargetOneGratingElevationDeg
        alpha_multiplier = 0
        dest_blend_factor = one
        autoplay = true
        )

    rectangle targetOne_contrast_rectangle (
        color = 0.5, 0.5, 0.5
        x_size = tTargetOneGratingDiameterDeg
        x_position = tTargetOneGratingAzimuthDeg
        y_position = tTargetOneGratingElevationDeg
        alpha_multiplier = tTargetOneGratingContrast
        source_blend_factor = one_minus_source_alpha
        dest_blend_factor = one
        )

    // Make the plaid 100% opaque.  Without this, the plaid's net alpha would
    // be less than zero, and its color would be blended with the stimulus
    // display background when the layer is drawn.
    rectangle targetOne_opacity_rectangle (
        x_size = tTargetOneGratingDiameterDeg
        x_position = tTargetOneGratingAzimuthDeg
        y_position = tTargetOneGratingElevationDeg
        source_blend_factor = zero
        dest_blend_factor = one
        source_alpha_blend_factor = one
        dest_alpha_blend_factor = zero
        )

    mask targetOne_maskType (
        mask = maskType
        std_dev = gratingStd
        mean = gratingMean
        edge_width = gratingEdge
        x_size = tTargetOneGratingDiameterDeg
        x_position = tTargetOneGratingAzimuthDeg
        y_position = tTargetOneGratingElevationDeg
        )
}

layer targetTwo {
    drifting_grating targetTwo_grating (
        direction = tTargetTwoGratingDirectionDeg
        starting_phase = tTargetTwoGratingPhaseDeg + 360 *  tTargetTwoGratingSpatialFreqCPD * (tTargetTwoGratingDiameterDeg/2)
        spatial_frequency = tTargetTwoGratingSpatialFreqCPD
        speed = tTargetTwoGratingTemporalFreqCPS/tTargetTwoGratingSpatialFreqCPD
        grating_type = gratingType
        x_size = tTargetTwoGratingDiameterDeg
        x_position = tTargetTwoGratingAzimuthDeg
        y_position = tTargetTwoGratingElevationDeg
        alpha_multiplier = tTargetTwoGratingContrast
        dest_blend_factor = zero
        autoplay = true
        )

    drifting_grating targetTwo_mask (
        direction = 0
        starting_phase = 0
        spatial_frequency = tTargetTwoGratingSpatialFreqCPD
        speed = 0
        grating_type = gratingType
        x_size = tTargetTwoGratingDiameterDeg
        x_position = tTargetTwoGratingAzimuthDeg
        y_position = tTargetTwoGratingElevationDeg
        alpha_multiplier = 0
        dest_blend_factor = one
        autoplay = true
        )

    rectangle targetTwo_contrast_rectangle (
        color = 0.5, 0.5, 0.5
        x_size = tTargetTwoGratingDiameterDeg
        x_position = tTargetTwoGratingAzimuthDeg
        y_position = tTargetTwoGratingElevationDeg
        alpha_multiplier = tTargetTwoGratingContrast
        source_blend_factor = one_minus_source_alpha
        dest_blend_factor = one
        )

    // Make the plaid 100% opaque.  Without this, the plaid's net alpha would
    // be less than zero, and its color would be blended with the stimulus
    // display background when the layer is drawn.
    rectangle targetTwo_opacity_rectangle (
        x_size = tTargetTwoGratingDiameterDeg
        x_position = tTargetTwoGratingAzimuthDeg
        y_position = tTargetTwoGratingElevationDeg
        source_blend_factor = zero
        dest_blend_factor = one
        source_alpha_blend_factor = one
        dest_alpha_blend_factor = zero
        )

    mask targetTwo_maskType (
        mask = maskType
        std_dev = gratingStd
        mean = gratingMean
        edge_width = gratingEdge
        x_size = tTargetTwoGratingDiameterDeg
        x_position = tTargetTwoGratingAzimuthDeg
        y_position = tTargetTwoGratingElevationDeg
        )
}

layer distractOne {
    drifting_grating distractOne_grating (
        direction = setDistractOneGratingDirectionDeg
        starting_phase = tDistractOneGratingPhaseDeg + 360 *  tDistractOneGratingSpatialFreqCPD * (tDistractOneGratingDiameterDeg/2)
        spatial_frequency = tDistractOneGratingSpatialFreqCPD
        speed = tDistractOneGratingTemporalFreqCPS/tDistractOneGratingSpatialFreqCPD
        grating_type = gratingType
        x_size = tDistractOneGratingDiameterDeg
        x_position = tDistractOneGratingAzimuthDeg
        y_position = tDistractOneGratingElevationDeg
        alpha_multiplier = tDistractOneGratingContrast
        dest_blend_factor = zero
        autoplay = true
        )

    drifting_grating distractOne_mask (
        direction = 0
        starting_phase = 0
        spatial_frequency = tDistractOneGratingSpatialFreqCPD
        speed = 0
        grating_type = gratingType
        x_size = tDistractOneGratingDiameterDeg
        x_position = tDistractOneGratingAzimuthDeg
        y_position = tDistractOneGratingElevationDeg
        alpha_multiplier = 0
        dest_blend_factor = one
        autoplay = true
        )

    rectangle distractOne_contrast_rectangle (
        color = 0.5, 0.5, 0.5
        x_size = tDistractOneGratingDiameterDeg
        x_position = tDistractOneGratingAzimuthDeg
        y_position = tDistractOneGratingElevationDeg
        alpha_multiplier = tDistractOneGratingContrast
        source_blend_factor = one_minus_source_alpha
        dest_blend_factor = one
        )

    // Make the plaid 100% opaque.  Without this, the plaid's net alpha would
    // be less than zero, and its color would be blended with the stimulus
    // display background when the layer is drawn.
    rectangle distractOne_opacity_rectangle (
        x_size = tDistractOneGratingDiameterDeg
        x_position = tDistractOneGratingAzimuthDeg
        y_position = tDistractOneGratingElevationDeg
        source_blend_factor = zero
        dest_blend_factor = one
        source_alpha_blend_factor = one
        dest_alpha_blend_factor = zero
        )

    mask distractOne_maskType (
        mask = maskType
        std_dev = gratingStd
        mean = gratingMean
        edge_width = gratingEdge
        x_size = tDistractOneGratingDiameterDeg
        x_position = tDistractOneGratingAzimuthDeg
        y_position = tDistractOneGratingElevationDeg
        )
}

layer distractTwo {
    drifting_grating distractTwo_grating (
        direction = tDistractTwoGratingDirectionDeg
        starting_phase = tDistractTwoGratingPhaseDeg + 360 *  tDistractTwoGratingSpatialFreqCPD * (tDistractTwoGratingDiameterDeg/2)
        spatial_frequency = tDistractTwoGratingSpatialFreqCPD
        speed = tDistractTwoGratingTemporalFreqCPS/tDistractTwoGratingSpatialFreqCPD
        grating_type = gratingType
        x_size = tDistractTwoGratingDiameterDeg
        x_position = tDistractTwoGratingAzimuthDeg
        y_position = tDistractTwoGratingElevationDeg
        alpha_multiplier = tDistractTwoGratingContrast
        dest_blend_factor = zero
        autoplay = true
        )

    drifting_grating distractTwo_mask (
        direction = 0
        starting_phase = 0
        spatial_frequency = tDistractTwoGratingSpatialFreqCPD
        speed = 0
        grating_type = gratingType
        x_size = tDistractTwoGratingDiameterDeg
        x_position = tDistractTwoGratingAzimuthDeg
        y_position = tDistractTwoGratingElevationDeg
        alpha_multiplier = 0
        dest_blend_factor = one
        autoplay = true
        )

    rectangle distractTwo_contrast_rectangle (
        color = 0.5, 0.5, 0.5
        x_size = tDistractTwoGratingDiameterDeg
        x_position = tDistractTwoGratingAzimuthDeg
        y_position = tDistractTwoGratingElevationDeg
        alpha_multiplier = tDistractTwoGratingContrast
        source_blend_factor = one_minus_source_alpha
        dest_blend_factor = one
        )

    // Make the plaid 100% opaque.  Without this, the plaid's net alpha would
    // be less than zero, and its color would be blended with the stimulus
    // display background when the layer is drawn.
    rectangle distractTwo_opacity_rectangle (
        x_size = tDistractTwoGratingDiameterDeg
        x_position = tDistractTwoGratingAzimuthDeg
        y_position = tDistractTwoGratingElevationDeg
        source_blend_factor = zero
        dest_blend_factor = one
        source_alpha_blend_factor = one
        dest_alpha_blend_factor = zero
        )

    mask distractTwo_maskType (
        mask = maskType
        std_dev = gratingStd
        mean = gratingMean
        edge_width = gratingEdge
        x_size = tDistractTwoGratingDiameterDeg
        x_position = tDistractTwoGratingAzimuthDeg
        y_position = tDistractTwoGratingElevationDeg
        )
}

drifting_grating photoDiodeGrating (
    direction = 0
    autoplay = YES
    starting_phase = 0
    spatial_frequency = .000000000001
    speed = 0
    grating_type = sinusoid
    mask = gaussian
    std_dev = 0.3
    mean = 0.1
    x_size = photoStimulusWidth
    y_size = photoStimulusHeight
    x_position = photoStimulusAzimuth
    y_position = photoStimulusElevation
    rotation = 0
    alpha_multiplier = photoStimulusContrast
    )
drifting_grating photoDiodeMask (
    direction = 0
    autoplay = YES
    starting_phase = 180
    spatial_frequency = photoMaskSpatialFreq
    speed = 0
    grating_type = sinusoid
    mask = gaussian
    std_dev = 0.3
    mean = 0.1
    x_size = photoStimulusWidth
    y_size = photoStimulusHeight
    x_position = photoStimulusAzimuth
    y_position = photoStimulusElevation
    rotation = 0
    alpha_multiplier = 1
    )


//
// Protocols
//

protocol JuiceOnHoldProtocol {
    // init actions run only on first trial after loading experiment 
    queue_stimulus (background)
    update_stimulus_display ()
    start_device_io (LabJackU6)
    report ('**** This is 1st trial')
    counter = 0
    if (ntrials == 0) {
        report ('**** First trial since experiment load - initializing')
        tLastTrialStartTimeMs = -1
        tThisTrialStartTimeMs = -1
        lastTrialTimeMs = 0
        isFirstTrial = 1
        // reset selection var 
        reset_selection (svStimNumber)
        reset_selection (svStimNumber2)
        tNStimAccepted = 0
        tNStimAccepted2 = 0
        reset_selection (svDistNumber)
        reset_selection (svDistNumber2)
        tNDistAccepted = 0
        tNDistAccepted2 = 0
    }
    trial 'Trial 01' (nsamples = 2500) {
        task TS {
            state Initialization {
                if (ntrials > 0) {
                    isFirstTrial = 0
                }
                sync = 1

                if (doPhotodiode) {
                    live_queue_stimulus (photoDiodeMask)
                    update_stimulus_display ()
                }

                // In this state, do all stimulus selection/tValue setting 
                report ('Initializing Trial')
                // Reset t_____RemainingOn/Off to 0ms 
                tempMs = 0
                tTrialStartMWTimestampMs = now()/1000
                // integer valued ms timestamp 
                strobedDigitalWord = 170
                strobedDigitalWord = 170
                strobedDigitalWord = 170
                //Transmit the trial timestamp so strobed code sequences are unique 
                assert (
                    condition = tTrialStartMWTimestampMs <= 2147483648
                    message = 'tTrialStartMWTimestampMs is too large - should happen only after several days of running!?'
                    stop_on_failure = 1
                    )
                // prevent overflow outside 2**31ms ~ 10 days - I don't know how to get unsigned casts in the XML 
                // encode trialStartTimestamp in bytes: 4 bytes: millions of seconds, 1000s, s, ms 
                strobedDigitalWord = 200
                strobedDigitalWord = 201
                trialStart = 1
                experimentXmlTrialId = 8
                // choose correct stimulus number based on odds; block2 tr number does not get assigned if ! doBlock2 
                tStimulusNumber = svStimNumber
                // choose a value from selection var, 0-origin 
                tStimulusNumber2 = svStimNumber2
                // choose a value from selection var, 0-origin 
                tDistNumber = svDistNumber
                // choose a value from selection var, 0-origin 
                tDistNumber2 = svDistNumber2
                // choose a value from selection var, 0-origin 
                
                // set default variables 
                tISITimeMs = isiTimeMs
                tStimOneDoVisualStim = stimOneDoVisualStim
                tStimOneGratingOnTimeMs = stimOneGratingOnTimeMs
                tTargetOneGratingDirectionDeg = targetOneGratingDirectionDeg
                tTargetOneGratingContrast = targetOneGratingContrast
                tTargetOneGratingElevationDeg = targetOneGratingElevationDeg
                tTargetOneGratingAzimuthDeg = targetOneGratingAzimuthDeg
                tTargetOneGratingDiameterDeg = targetOneGratingDiameterDeg
                tTargetOneGratingSpatialFreqCPD = targetOneGratingSpatialFreqCPD
                tTargetOneGratingTemporalFreqCPS = targetOneGratingTemporalFreqCPS
                tTargetOneGratingPhaseDeg = targetOneGratingPhaseDeg
                if (!distractOneMatchTargetOne) {
                    tDistractOneGratingDirectionDeg = distractOneGratingDirectionDeg
                    tDistractOneGratingContrast = distractOneGratingContrast
                    tDistractOneGratingPhaseDeg = distractOneGratingPhaseDeg
                    tDistractOneGratingTemporalFreqCPS = distractOneGratingTemporalFreqCPS
                    tDistractOneGratingSpatialFreqCPD = distractOneGratingSpatialFreqCPD
                    tDistractOneGratingAzimuthDeg = distractOneGratingAzimuthDeg
                    tDistractOneGratingElevationDeg = distractOneGratingElevationDeg
                    tDistractOneGratingDiameterDeg = distractOneGratingDiameterDeg 
                    tStimTwoDoVisualStim = stimTwoDoVisualStim
                }
                if (distractOneMatchTargetOne) {
                    tDistractOneGratingDirectionDeg = targetOneGratingDirectionDeg
                    tDistractOneGratingContrast = targetOneGratingContrast
                    tDistractOneGratingPhaseDeg = targetOneGratingPhaseDeg
                    tDistractOneGratingTemporalFreqCPS = targetOneGratingTemporalFreqCPS
                    tDistractOneGratingSpatialFreqCPD = targetOneGratingSpatialFreqCPD
                    tDistractOneGratingAzimuthDeg = targetOneGratingAzimuthDeg
                    tDistractOneGratingElevationDeg = targetOneGratingElevationDeg
                    tDistractOneGratingDiameterDeg = targetOneGratingDiameterDeg 
                    tStimTwoDoVisualStim = stimTwoDoVisualStim
                }
                tDoMatrix = doMatrix
                tDoRandISITime = doRandISITime
                tDoRandStimOnTime = doRandStimOnTime
                tDoRandCon = doRandCon
                tDoRandDir = doRandDir
                tDoDistRandDir = doDistractRandDir
                tDoRandPos = doRandPos
                tDoRandDiameter = doRandDiameter
                tDoRandSF = doRandSF
                tDoRandTF = doRandTF
                tDoRandPhase = doRandPhase
                if (matchTargetOneParameters) {
                    tStimTwoGratingOnTimeMs = stimOneGratingOnTimeMs
                    tTargetTwoGratingDirectionDeg = targetOneGratingDirectionDeg
                    tTargetTwoGratingContrast = targetOneGratingContrast
                    tTargetTwoGratingElevationDeg = targetOneGratingElevationDeg
                    tTargetTwoGratingAzimuthDeg = targetOneGratingAzimuthDeg
                    tTargetTwoGratingDiameterDeg = targetOneGratingDiameterDeg
                    tTargetTwoGratingSpatialFreqCPD = targetOneGratingSpatialFreqCPD
                    tTargetTwoGratingTemporalFreqCPS = targetOneGratingTemporalFreqCPS
                    tTargetTwoGratingPhaseDeg = targetOneGratingPhaseDeg
                    if (!distractOneMatchTargetOne) {
                        tDistractTwoGratingDirectionDeg = distractOneGratingDirectionDeg
                        tDistractTwoGratingContrast = distractOneGratingContrast
                        tDistractTwoGratingPhaseDeg = distractOneGratingPhaseDeg
                        tDistractTwoGratingSpatialFreqCPD = distractOneGratingSpatialFreqCPD
                        tDistractTwoGratingAzimuthDeg = distractOneGratingAzimuthDeg
                        tDistractTwoGratingElevationDeg = distractOneGratingElevationDeg
                        tDistractTwoGratingDiameterDeg = distractOneGratingDiameterDeg 
                    }
                    if (distractOneMatchTargetOne) {
                        tDistractTwoGratingDirectionDeg = targetOneGratingDirectionDeg
                        tDistractTwoGratingContrast = targetOneGratingContrast
                        tDistractTwoGratingPhaseDeg = targetOneGratingPhaseDeg
                        tDistractTwoGratingSpatialFreqCPD = targetOneGratingSpatialFreqCPD
                        tDistractTwoGratingAzimuthDeg = targetOneGratingAzimuthDeg
                        tDistractTwoGratingElevationDeg = targetOneGratingElevationDeg
                        tDistractTwoGratingDiameterDeg = targetOneGratingDiameterDeg 
                    }
                }
                if (!matchTargetOneParameters) {
                    tStimTwoGratingOnTimeMs = stimTwoGratingOnTimeMs
                    tTargetTwoGratingDirectionDeg = targetTwoGratingDirectionDeg
                    tTargetTwoGratingContrast = targetTwoGratingContrast
                    tTargetTwoGratingElevationDeg = targetTwoGratingElevationDeg
                    tTargetTwoGratingAzimuthDeg = targetTwoGratingAzimuthDeg
                    tTargetTwoGratingDiameterDeg = targetTwoGratingDiameterDeg
                    tTargetTwoGratingSpatialFreqCPD = targetTwoGratingSpatialFreqCPD
                    tTargetTwoGratingTemporalFreqCPS = targetTwoGratingTemporalFreqCPS
                    tTargetTwoGratingPhaseDeg = targetTwoGratingPhaseDeg
                    tDistractTwoGratingDirectionDeg = distractTwoGratingDirectionDeg
                    tDistractTwoGratingPhaseDeg = distractTwoGratingPhaseDeg
                    tDistractTwoGratingContrast = distractTwoGratingContrast
                    tDistractTwoGratingSpatialFreqCPD = distractTwoGratingSpatialFreqCPD
                    tDistractTwoGratingAzimuthDeg = distractTwoGratingAzimuthDeg
                    tDistractTwoGratingElevationDeg = distractTwoGratingElevationDeg
                    tDistractTwoGratingDiameterDeg = distractTwoGratingDiameterDeg 
                }
                
                // single condition calculations 
                if (tDoRandISITime) {
                    tTempStim1 = tStimulusNumber % isiTimeN
                    tISITimeMs = isiTimeMs * pow(isiTimeStepLog,tTempStim1)
                }
                if (tDoRandStimOnTime) {
                    tTempStim1 = tStimulusNumber % stimOneGratingOnTimeStepN
                    tStimOneGratingOnTimeMs = stimOneGratingOnTimeMs * pow(stimOneGratingOnTimeStepLog,tTempStim1)
                    if (matchTargetOneParameters) {
                        tStimTwoGratingOnTimeMs = (double)tStimOneGratingOnTimeMs
                    }
                    if (!matchTargetOneParameters) {
                        tTempStim2 = tStimulusNumber2 % stimTwoGratingOnTimeStepN
                        tStimTwoGratingOnTimeMs = stimTwoGratingOnTimeMs * pow(stimTwoGratingOnTimeStepLog,tTempStim2)
                    }
                }
                
                if (tDoRandCon) {
                    tTempStim1 = tStimulusNumber % targetOneGratingContrastStepN
                    tTargetOneGratingContrast = targetOneGratingContrast * pow(targetOneGratingContrastStepLog,tTempStim1)
                    if (doZeroCon && tStimulusNumber < zeroConPer80) {
                        tTargetOneGratingContrast = 0
                    }
                    if (matchTargetOneParameters) {
                        tTargetTwoGratingContrast = tTargetOneGratingContrast
                    }
                    if (!matchTargetOneParameters) {
                        tTempStim2 = tStimulusNumber2 % targetTwoGratingContrastStepN
                        tTargetTwoGratingContrast = targetTwoGratingContrast * pow(targetTwoGratingContrastStepLog,tTempStim2)
                        if (doZeroCon && tStimulusNumber2 < zeroConPer80) {
                            tTargetTwoGratingContrast = 0
                        }
                    }
                }
                
                if (tDoRandDir) {
                    tTempStim1 = tStimulusNumber % targetOneGratingDirectionStepN
                    tTargetOneGratingDirectionDeg = targetOneGratingDirectionDeg + (targetOneGratingDirectionStepDeg * (tTempStim1))
                    if (!distractOneMatchTargetOne) {
                        tDistractOneGratingDirectionDeg = tTargetOneGratingDirectionDeg + distractOneGratingDirectionDeg
                    }
                    if (distractOneMatchTargetOne) {
                        tDistractOneGratingDirectionDeg = tTargetOneGratingDirectionDeg
                    }
                    if (matchTargetOneParameters) {
                        tTargetTwoGratingDirectionDeg = tTargetOneGratingDirectionDeg
                        tDistractTwoGratingDirectionDeg = tDistractOneGratingDirectionDeg
                    }
                    if (!matchTargetOneParameters) {
                        tTempStim2 = tStimulusNumber2 % targetTwoGratingDirectionStepN
                        tTargetTwoGratingDirectionDeg = targetTwoGratingDirectionDeg + (targetTwoGratingDirectionStepDeg * (tTempStim2))
                        if (!distractOneMatchTargetOne) {
                            tDistractTwoGratingDirectionDeg = tTargetTwoGratingDirectionDeg + distractTwoGratingDirectionDeg
                        }
                        if (distractOneMatchTargetOne) {
                            tDistractTwoGratingDirectionDeg = tTargetTwoGratingDirectionDeg
                        }
                    }
                }
                if (tDoDistRandDir) {
                    tTempDist1 = tDistNumber % distractOneGratingDirectionStepN
                    tDistractOneGratingDirectionDeg = distractOneGratingDirectionDeg + (distractOneGratingDirectionStepDeg * (tTempDist1))
                    if (matchDistractOneParameters) {
                        tDistractTwoGratingDirectionDeg = tDistractOneGratingDirectionDeg
                    }
                    if (!matchDistractOneParameters) {
                        tTempDist2 = tDistNumber2 % distractTwoGratingDirectionStepN
                        tDistractTwoGratingDirectionDeg = distractTwoGratingDirectionDeg + (distractTwoGratingDirectionStepDeg * (tTempDist2))
                    }
                }

                if (tDoRandPhase) {
                    tTempStim1 = tStimulusNumber % targetOneGratingPhaseStepN
                    tTargetOneGratingPhaseDeg = targetOneGratingPhaseDeg + (targetOneGratingPhaseStepDeg * (tTempStim1))
                    if (matchTargetOneParameters) {
                        tTargetTwoGratingPhaseDeg = tTargetOneGratingPhaseDeg
                    }
                    if (!matchTargetOneParameters) {
                        tTempStim2 = tStimulusNumber2 % targetTwoGratingPhaseStepN
                        tTargetTwoGratingPhaseDeg = targetTwoGratingPhaseDeg + (targetTwoGratingPhaseStepDeg * (tTempStim2))
                    }
                }
                if (tDoRandDiameter) {
                    tTempStim1 = tStimulusNumber % targetOneGratingDiameterStepN
                    tTargetOneGratingDiameterDeg = targetOneGratingDiameterDeg * pow(targetOneGratingDiameterStepLog,tTempStim1)
                    if (matchTargetOneParameters) {
                        tTargetTwoGratingDiameterDeg = tTargetOneGratingDiameterDeg
                    }
                    if (!matchTargetOneParameters) {
                        tTempStim2 = tStimulusNumber2 % targetTwoGratingDiameterStepN
                        tTargetTwoGratingDiameterDeg = targetTwoGratingDiameterDeg * pow(targetTwoGratingDiameterStepLog,tTempStim2)
                    }
                }
                if (tDoRandTF) {
                    tTempStim1 = tStimulusNumber % targetOneGratingTemporalFreqStepN
                    tTargetOneGratingTemporalFreqCPS = targetOneGratingTemporalFreqCPS * pow(targetOneGratingTemporalFreqStepLog,tTempStim1)
                    if (matchTargetOneParameters) {
                        tTargetTwoGratingTemporalFreqCPS = tTargetOneGratingTemporalFreqCPS
                    }
                    if (!matchTargetOneParameters) {
                        tTempStim2 = tStimulusNumber2 % targetTwoGratingTemporalFreqStepN
                        tTargetTwoGratingTemporalFreqCPS = targetTwoGratingTemporalFreqCPS * pow(targetTwoGratingTemporalFreqStepLog,tTempStim2)
                    }
                }
                if (tDoRandSF) {
                    tTempStim1 = tStimulusNumber % targetOneGratingSpatialFreqStepN
                    tTargetOneGratingSpatialFreqCPD = targetOneGratingSpatialFreqCPD * pow(targetOneGratingSpatialFreqStepLog,tTempStim1)
                    if (matchTargetOneParameters) {
                        tTargetTwoGratingSpatialFreqCPD = tTargetOneGratingSpatialFreqCPD
                    }
                    if (!matchTargetOneParameters) {
                        tTempStim2 = tStimulusNumber2 % targetTwoGratingSpatialFreqStepN
                        tTargetTwoGratingSpatialFreqCPD = targetTwoGratingSpatialFreqCPD * pow(targetTwoGratingSpatialFreqStepLog,tTempStim2)
                    }
                }
                if (tDoRandPos) {
                    tTempStim1 = tStimulusNumber % (targetOneGratingElevationStepN * targetOneGratingAzimuthStepN)
                    if (tTempStim1 < targetOneGratingAzimuthStepN) {
                        tTargetOneGratingAzimuthDeg = targetOneGratingAzimuthDeg + (targetOneGratingAzimuthStepDeg * (tTempStim1))
                        tTargetOneGratingElevationDeg = targetOneGratingElevationDeg
                    }
                    if (tTempStim1 >= targetOneGratingAzimuthStepN) {
                        tTargetOneGratingAzimuthDeg = targetOneGratingAzimuthDeg+ (targetOneGratingAzimuthStepDeg * ((tTempStim1) % targetOneGratingAzimuthStepN))
                        tTargetOneGratingElevationDeg = targetOneGratingElevationDeg+ (targetOneGratingElevationStepDeg * (floor(tTempStim1 / targetOneGratingAzimuthStepN)))
                    }
                    if (matchTargetOneParameters) {
                        tTargetTwoGratingAzimuthDeg = tTargetOneGratingAzimuthDeg
                        tTargetTwoGratingElevationDeg = tTargetOneGratingElevationDeg
                    }
                    if (!matchTargetOneParameters) {
                        tTempStim2 = tStimulusNumber % (targetTwoGratingElevationStepN * targetTwoGratingAzimuthStepN)
                        if (tTempStim1 < targetTwoGratingAzimuthStepN) {
                            tTargetTwoGratingAzimuthDeg = targetTwoGratingAzimuthDeg + (targetTwoGratingAzimuthStepDeg * (tTempStim2))
                            tTargetTwoGratingElevationDeg = targetTwoGratingElevationDeg
                        }
                        if (tTempStim1 >= targetTwoGratingAzimuthStepN) {
                            tTargetTwoGratingAzimuthDeg = targetTwoGratingAzimuthDeg+ (targetTwoGratingAzimuthStepDeg * ((tTempStim2) % targetTwoGratingAzimuthStepN))
                            tTargetTwoGratingElevationDeg = targetTwoGratingElevationDeg+ (targetTwoGratingElevationStepDeg * (floor(tTempStim2 / targetTwoGratingAzimuthStepN)))
                        }
                    }
                }
                if (tDoMatrix) { 
                    if (tDoRandDir && tDoRandPos) {
                        tTempStim1 = tStimulusNumber % targetOneGratingDirectionStepN
                        tTargetOneGratingDirectionDeg = targetOneGratingDirectionDeg + (targetOneGratingDirectionStepDeg * (tTempStim1))
                        if (!tDoDistRandDir) {
                            tDistractOneGratingDirectionDeg = tTargetOneGratingDirectionDeg + distractOneGratingDirectionDeg
                        }
                        if (matchTargetOneParameters) {
                            tTargetTwoGratingDirectionDeg = tTargetOneGratingDirectionDeg
                            if (!tDoDistRandDir) {
                                tDistractTwoGratingDirectionDeg = tTargetTwoGratingDirectionDeg + distractTwoGratingDirectionDeg
                            }
                        }
                        tTempStim2 = tStimulusNumber2 % (targetOneGratingElevationStepN * targetOneGratingAzimuthStepN)
                        if (tTempStim2 < targetOneGratingAzimuthStepN) {
                            tTargetOneGratingAzimuthDeg = targetOneGratingAzimuthDeg + (targetOneGratingAzimuthStepDeg * (tTempStim2))
                            tTargetOneGratingElevationDeg = targetOneGratingElevationDeg
                            report ('Azimuth is $tTargetOneGratingAzimuthDeg ; Elevation is $tTargetOneGratingElevationDeg')
                        }
                        if (tTempStim2 >= targetOneGratingAzimuthStepN) {
                            tTargetOneGratingAzimuthDeg = targetOneGratingAzimuthDeg+ (targetOneGratingAzimuthStepDeg * ((tTempStim2) % targetOneGratingAzimuthStepN))
                            tTargetOneGratingElevationDeg = targetOneGratingElevationDeg+ (targetOneGratingElevationStepDeg * (floor(tTempStim2 / targetOneGratingAzimuthStepN)))
                            report ('Azimuth is $tTargetOneGratingAzimuthDeg ; Elevation is $tTargetOneGratingElevationDeg')
                        }
                        tTempDist2 = (tStimulusNumber2 + 1) % (targetOneGratingElevationStepN * targetOneGratingAzimuthStepN)
                        if (tTempDist2 < targetOneGratingAzimuthStepN) {
                            tDistractOneGratingAzimuthDeg = targetOneGratingAzimuthDeg + (targetOneGratingAzimuthStepDeg * (tTempDist2))
                            tDistractOneGratingElevationDeg = targetOneGratingElevationDeg
                            report ('Azimuth is $tDistractOneGratingAzimuthDeg ; Elevation is $tDistractOneGratingElevationDeg')
                        }
                        if (tTempDist2 >= targetOneGratingAzimuthStepN) {
                            tDistractOneGratingAzimuthDeg = targetOneGratingAzimuthDeg+ (targetOneGratingAzimuthStepDeg * ((tTempDist2) % targetOneGratingAzimuthStepN))
                            tDistractOneGratingElevationDeg = targetOneGratingElevationDeg+ (targetOneGratingElevationStepDeg * (floor(tTempDist2 / targetOneGratingAzimuthStepN)))
                            report ('Azimuth is $tDistractOneGratingAzimuthDeg ; Elevation is $tDistractOneGratingElevationDeg')
                        }
                        if (matchTargetOneParameters) {
                            tTargetTwoGratingElevationDeg = tTargetOneGratingElevationDeg
                            tTargetTwoGratingAzimuthDeg = tTargetOneGratingAzimuthDeg
                            tDistractTwoGratingElevationDeg = tDistractOneGratingElevationDeg
                            tDistractTwoGratingAzimuthDeg = tDistractOneGratingAzimuthDeg
                        }        
                    }
                    if (tDoRandDir && tDoRandSF) {
                        tTempStim1 = tStimulusNumber % (targetOneGratingDirectionStepN * targetOneGratingSpatialFreqStepN)
                        if (tTempStim1 < targetOneGratingDirectionStepN) {
                            tTargetOneGratingDirectionDeg = targetOneGratingDirectionDeg + (targetOneGratingDirectionStepDeg * (tTempStim1))
                            if (!distractOneMatchTargetOne) {
                                tDistractOneGratingDirectionDeg = tTargetOneGratingDirectionDeg + distractOneGratingDirectionDeg
                            }
                            if (distractOneMatchTargetOne) {
                                tDistractOneGratingDirectionDeg = tTargetOneGratingDirectionDeg
                            }
                        }
                        if (tTempStim1 >= targetOneGratingDirectionStepN) {
                            tTargetOneGratingDirectionDeg = targetOneGratingDirectionDeg+ (targetOneGratingDirectionStepDeg * ((tTempStim1) % targetOneGratingDirectionStepN))
                            tTargetOneGratingSpatialFreqCPD = targetOneGratingSpatialFreqCPD * pow(targetOneGratingSpatialFreqStepLog, (floor(tTempStim1 / targetOneGratingDirectionStepN)))
                            if (!distractOneMatchTargetOne) {
                                tDistractOneGratingDirectionDeg = tTargetOneGratingDirectionDeg + distractOneGratingDirectionDeg
                                tDistractOneGratingSpatialFreqCPD = distractOneGratingSpatialFreqCPD * pow(targetOneGratingSpatialFreqStepLog, (floor(tTempStim1 / distractOneGratingDirectionStepN)))
                            }
                            if (distractOneMatchTargetOne) {
                                tDistractOneGratingDirectionDeg = tTargetOneGratingDirectionDeg
                                tDistractOneGratingSpatialFreqCPD = tTargetOneGratingSpatialFreqCPD
                            }
                        } 
                    }   
                }        
                    
                if (tDistractOneGratingContrast==0 || tTargetOneGratingContrast==0) {
                    tDistractOneGratingPhaseDeg = targetOneGratingPhaseDeg
                    tDistractTwoGratingPhaseDeg = targetTwoGratingPhaseDeg
                }
                if (!tStimOneDoVisualStim) {
                    tTargetOneGratingContrast = 0
                    tDistractOneGratingContrast = 0
                }
                if (tTargetOneGratingContrast > 1) {
                    tTargetOneGratingContrast = 1
                }
                if (tDistractOneGratingContrast > 1) {
                    tDistractOneGratingContrast = 1
                }
                if (tTargetTwoGratingContrast > 1) {
                    tTargetTwoGratingContrast = 1
                }
                if (tDistractTwoGratingContrast > 1) {
                    tDistractTwoGratingContrast = 1
                }
                if (tTargetOneGratingContrast < 0) {
                    tTargetOneGratingContrast = 0
                }
                if (tDistractOneGratingContrast < 0) {
                    tDistractOneGratingContrast = 0
                }
                if (tTargetTwoGratingContrast < 0) {
                    tTargetTwoGratingContrast = 0
                }
                if (tDistractTwoGratingContrast < 0) {
                    tDistractTwoGratingContrast = 0
                }
                
                report ('tTargetOneGratingContrast is $tTargetOneGratingContrast; tDistractOneGratingContrast is $tDistractOneGratingContrast')
                report ('tTargetOneGratingDirectionDeg is $tTargetOneGratingDirectionDeg; tDistractOneGratingDirectionDeg is $tDistractOneGratingDirectionDeg')
                setTargetOneGratingDirectionDeg = tTargetOneGratingDirectionDeg
                setDistractOneGratingDirectionDeg = tDistractOneGratingDirectionDeg
                
                // frame conversion 
                nStimOneFramesOn = ceil((tStimOneGratingOnTimeMs/1000)*frameRateHz)
                nStimTwoFramesOn = ceil((tStimTwoGratingOnTimeMs/1000)*frameRateHz)
                nFramesISI = ceil((tISITimeMs/1000)*frameRateHz)
                
                // initialize trial start/end times 
                if (tThisTrialStartTimeMs == -1) {
                    //first trial, leave lasttime as -1 
                    tLastTrialStartTimeMs = -1
                }
                if (tThisTrialStartTimeMs != -1) {
                    //else
                    //later trials, copy this into last before setting this again below 
                    tLastTrialStartTimeMs = tThisTrialStartTimeMs
                }
                tThisTrialStartTimeMs = now()/1000
                // compute ITI time 
                // initialize with a const value 
                tItiWaitTimeMs = itiTimeMs
                if (tDoRandStimOnTime) {
                    maxStimOnTime = (stimOneGratingOnTimeMs * pow(stimOneGratingOnTimeStepLog,stimOneGratingOnTimeStepN)) + (stimTwoGratingOnTimeMs * pow(stimTwoGratingOnTimeStepLog,stimTwoGratingOnTimeStepN))
                }
                if (!tDoRandStimOnTime) {
                    maxStimOnTime = stimOneGratingOnTimeMs + stimTwoGratingOnTimeMs
                }
                if (tDoRandISITime) {
                    maxISITime = isiTimeMs * pow(isiTimeStepLog,isiTimeN)
                }
                if (!tDoRandISITime) {
                    maxISITime = isiTimeMs
                }
                if (tempMs >= 0) {
                    //add to ITI
                    tItiWaitTimeMs = itiTimeMs+tempMs
                }
                tItiWaitFrames = ceil((tItiWaitTimeMs/1000)*frameRateHz)

                cItiStart = counter
                strobedDigitalWord = 6
                if (doWheelSpeed == 1) {
                    doCerebellarStim = 0
                    DoWheelSpeed = doWheelSpeed
                    speedIntervalUS = speedIntervalMS*1000
                }
                report ('In ITI, waiting $tItiWaitFrames')
                goto (
                    target = TargetOneOn
                    when = counter >= (cItiStart + tItiWaitFrames) && isFirstTrial && counter > 19
                    )
                goto (
                    target = TargetOneOn
                    when = counter >= (cItiStart + tItiWaitFrames) && !isFirstTrial
                    )
            }
            state TargetOneOn {
                ntrials = ntrials + 1
                live_queue_stimulus (targetOne)
                live_queue_stimulus (distractOne)

                if (doPhotodiode) {
                    live_queue_stimulus (photoDiodeGrating)
                    dequeue_stimulus (photoDiodeMask)
                }

                update_stimulus_display ()
               
                cStimOneOn = counter
                mwStimOneOnMs = now()/1000
                report ('TargetOne on')
                goto (
                    target = TargetOneOff
                    when = counter >= (cStimOneOn + nStimOneFramesOn)
                    )
            }
            
            state TargetOneOff {
                dequeue_stimulus (targetOne)
                dequeue_stimulus (distractOne)

                if (doPhotodiode) {
                    live_queue_stimulus (photoDiodeMask)
                    dequeue_stimulus (photoDiodeGrating)
                }

                update_stimulus_display ()
                cStimOneOff = counter
                mwStimOneOffMs = (now()/1000)
                goto (
                    target = TargetTwoOn
                    when = counter  >= (cStimOneOff + nFramesISI)
                    )
            }
            state TargetTwoOn {

                live_queue_stimulus (targetTwo)
                live_queue_stimulus (distractTwo)

                if (doPhotodiode && stimTwoDoVisualStim) {
                    live_queue_stimulus (photoDiodeGrating)
                    dequeue_stimulus (photoDiodeMask)
                }

                update_stimulus_display ()
                
                cStimTwoOn = counter
                mwStimTwoOnMs = now()/1000
                report ('TargetTwo on')
                
                goto (
                    target = TargetTwoOff
                    when = counter >= (cStimTwoOn + nStimTwoFramesOn)
                    )
            }
            state TargetTwoOff {
                dequeue_stimulus (targetTwo)
                dequeue_stimulus (distractTwo)

                if (doPhotodiode) {
                    live_queue_stimulus (photoDiodeMask)
                    dequeue_stimulus (photoDiodeGrating)
                }
                
                update_stimulus_display ()
                cStimTwoOff = counter
                mwStimTwoOffMs = (now()/1000)
                
                goto (
                    target = EndTrial
                    when = counter  >= (cStimTwoOff + 3)
                    )
            }
            state EndTrial {
                report ('Trial Ended')
                // accept stim selection 
                accept_selections (svStimNumber)
                tNStimAccepted = tNStimAccepted + 1
                // update selection variable 
                if (tNStimAccepted >= 80) {
                    reset_selection (svStimNumber)
                    tNStimAccepted = 0
                    report ('Should be resetting selections,tNStimAccepted=$tNStimAccepted')
                }
                if (tNStimAccepted < 80) {
                    next_selection (svStimNumber)
                    report ('Next selection,tNStimAccepted=$tNStimAccepted')
                }
                accept_selections (svStimNumber2)
                tNStimAccepted2 = tNStimAccepted2 + 1
                // update selection variable 
                if (tNStimAccepted2 >= 80) {
                    reset_selection (svStimNumber2)
                    tNStimAccepted2 = 0
                }
                if (tNStimAccepted2 < 80) {
                    next_selection (svStimNumber2)
                }
                accept_selections (svDistNumber)
                tNDistAccepted = tNDistAccepted + 1
                // update selection variable 
                if (tNDistAccepted >= 80) {
                    reset_selection (svDistNumber)
                    tNDistAccepted = 0
                }
                if (tNDistAccepted < 80) {
                    next_selection (svDistNumber)
                }
                accept_selections (svDistNumber2)
                tNDistAccepted2 = tNDistAccepted2 + 1
                // update selection variable 
                if (tNDistAccepted2 >= 80) {
                    reset_selection (svDistNumber2)
                    tNDistAccepted2 = 0
                }
                if (tNDistAccepted2 < 80) {
                    next_selection (svDistNumber2)
                }
                if (doWheelSpeed == 1) {
                    DoWheelSpeed = 0
                }
                sync = 0
                yield ()
            }
        }
    }
    stop_device_io (LabJackU6)
    dequeue_stimulus (targetTwo)
    update_stimulus_display ()
}
